# Everything listed here is never sent to the Docker build. Keeps the build
# fast and makes sure local secrets and build output can't end up in an image.

# Build output and IDE state
**/bin/
**/obj/
**/.vs/
**/.vscode/
**/.idea/
**/*.user
**/TestResults/

# Not needed to build the API
.git/
.github/
LuxuryStore.UnitTests/
*.md
docker-compose*.yml
Dockerfile
.dockerignore

# Local secrets — never in an image
.env
.env.*
**/appsettings.*.local.json
**/appsettings.Local.json
**/*.pfx
**/*.pem
