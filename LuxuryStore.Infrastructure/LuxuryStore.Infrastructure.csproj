<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LuxuryStore.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuxuryStore.Application\LuxuryStore.Application.csproj" />
    <ProjectReference Include="..\LuxuryStore.Domain\LuxuryStore.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Design-time tooling for `dotnet ef migrations add ...`. Lives here
         (next to AppDbContext) rather than in the API project, per the usual
         Clean Architecture convention. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pinned as a floating minimum (>= 10.0.4), not an exact version: EF Core
         Design pulls Microsoft.Extensions.Caching.Memory 10.0.4, which itself
         requires these two at >= 10.0.4. Pinning them lower than that is a
         package downgrade (NU1605, treated as a build error by the SDK).
         Floating instead of an exact "10.0.4" means a future patch bump
         elsewhere in the chain won't trigger this same conflict again. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="[10.0.4,)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.4,)" />
    <!-- Forces the patched version — 9.0.0 (a transitive dependency somewhere
         in this chain) is affected by CVE-2026-50648 (GHSA-23rf-6693-g89p, a
         high-severity DoS via crafted encrypted XML). Patched in the 10.0.x
         line as of 10.0.10. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="[10.0.10,)" />
  </ItemGroup>

</Project>
