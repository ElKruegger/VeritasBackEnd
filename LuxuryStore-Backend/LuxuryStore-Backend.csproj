<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LuxuryStore_Backend</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Test UI for the OpenAPI document Microsoft.AspNetCore.OpenApi already
         generates. .NET 10's template dropped Swagger UI by default (that's
         Swashbuckle, which the Microsoft docs steer people away from as of
         .NET 9+) — Scalar is the current recommended replacement and its UI
         matches the project's dark/minimalist visual identity. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuxuryStore.Application\LuxuryStore.Application.csproj" />
    <ProjectReference Include="..\LuxuryStore.Infrastructure\LuxuryStore.Infrastructure.csproj" />
  </ItemGroup>

</Project>
