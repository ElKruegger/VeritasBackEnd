<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LuxuryStore_Backend</RootNamespace>
    <UserSecretsId>7f8c5f2d-258a-40a9-823c-68dfd020e44a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Test UI for the OpenAPI document Microsoft.AspNetCore.OpenApi already
         generates. .NET 10's template dropped Swagger UI by default (that's
         Swashbuckle, which the Microsoft docs steer people away from as of
         .NET 9+) — Scalar is the current recommended replacement and its UI
         matches the project's dark/minimalist visual identity. -->
    <PackageReference Include="Scalar.AspNetCore" Version="3.1.1" />
    <!-- Configures the JWT Bearer *validation* middleware in Program.cs
         (AddAuthentication().AddJwtBearer(...)). LuxuryStore.Infrastructure
         references the same package separately, to *issue* tokens in
         TokenService — different concern, different project. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Structured logging (brief section 3). AspNetCore brings
         Serilog.Extensions.Hosting (UseSerilog) and a console sink;
         Settings.Configuration adds ReadFrom.Configuration so the "Serilog"
         section in appsettings.json/appsettings.Development.json drives
         minimum levels without a code change per environment. -->
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <!-- Lets the unit tests check internal helpers such as AuthCookies
       without making them part of the API project's public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LuxuryStore.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LuxuryStore.Application\LuxuryStore.Application.csproj" />
    <ProjectReference Include="..\LuxuryStore.Infrastructure\LuxuryStore.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Security floor: EF Core Design (below) drags in
         System.Security.Cryptography.Pkcs 9.0.0 through its MSBuild/Roslyn
         chain (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Same floor as
         LuxuryStore.Infrastructure — keep the two in sync. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="[10.0.13,)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The EF Core CLI tools (dotnet ef migrations/database update) resolve
         design-time services by walking the STARTUP project's own direct
         package references — they don't follow ProjectReferences into
         Infrastructure to find it there, even though that's where
         AppDbContext actually lives. Infrastructure's copy is marked
         PrivateAssets="all" too, so it doesn't flow up transitively either.
         Net result: this package has to be referenced directly in both
         places. Same version and asset restriction as Infrastructure's, so
         none of this tooling ships in the published API output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
